---
- name: Check if ceph.conf exists
  stat:
    path: "/etc/ceph/ceph.conf"
  register: ceph_conf_check

- name: Copy ceph.conf file from localhost to nodes without ceph.conf
  synchronize:
    src: "/etc/ceph/ceph.conf"
    dest: "/etc/ceph/ceph.conf"
  when: not ceph_conf_check.stat.exists and host_ceph_conf_check.stat.exists
  delegate_to: localhost
